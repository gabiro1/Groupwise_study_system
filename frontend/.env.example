# Server-only backend URL used by the Next.js BFF route handlers.
#
# The browser never reads this value: it calls same-origin /api/* routes, which
# proxy to this backend. Do NOT rename it to NEXT_PUBLIC_BACKEND_API_URL or
# VITE_API_URL, and do not commit a real .env file.
#
# Optional in production: the app falls back to
# https://groupwise-study-system.onrender.com when this is unset. Set it to
# override that fallback (staging, a custom backend domain, etc.).
#
# Local development:
BACKEND_API_URL=http://localhost:4000
#
# Vercel (Project Settings -> Environment Variables), for Production and Preview:
# BACKEND_API_URL=https://<your-render-service>.onrender.com
#
# Enter the origin only. A trailing slash or a trailing /api is tolerated, but
# the clean form above is preferred.
