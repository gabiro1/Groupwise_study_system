# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing and coverage
coverage/

# Build and runtime output
build/
dist/
storage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
#
# `.env` holds the real Postgres password and the session-signing secret, so it
# must never be committed. The negation matters: the broad `.env*` rule that
# Next.js scaffolds would otherwise also hide `.env.example`, which *is* meant to
# be committed so others know which variables exist.
.env
.env.*
!.env.example

# Uploaded files are user content, not source.
storage/uploads/
!storage/uploads/.gitkeep

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp