{
  "name": "lien-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Lien API — matching, study groups and collaborative workspaces.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "seed": "node src/db/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:scoring": "node --test tests/scoring.test.js tests/features.test.js",
    "lint": "node scripts/lint.js",
    "check:schema": "node scripts/check-schema.js",
    "verify": "node scripts/lint.js && node scripts/check-schema.js && node --test \"tests/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
