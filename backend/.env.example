# =============================================================================
# Lien API - example environment
#
# Copy to `.env` and fill in the blanks:
#   cp .env.example .env
#
# Only two values have no safe default:
#   - DATABASE_URL  a PostgreSQL connection string
#   - AUTH_SECRET   32+ random characters
#
# Everything else is optional and defaults to a local development setup.
# `DATABASE_URL` and `AUTH_SECRET` are the only settings the API refuses to
# start without; the boot check prints every missing value at once.
# =============================================================================

# --- Core --------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Where the browser reaches the frontend. Used for links in emails.
APP_URL=http://localhost:3000

# --- Database (required) ----------------------------------------------------
# Local development. The database must already exist; `npm run db:create`
# creates it, or you can run `CREATE DATABASE twigane;` yourself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twigane
# Managed instance (uncomment and set):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

DATABASE_POOL_MAX=10
# Set both to true when your provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Apply pending migrations during boot. Convenient locally, but leave it false in
# production so migrations run as a separate release step.
RUN_MIGRATIONS_ON_BOOT=false

# --- Auth (required) --------------------------------------------------------
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later invalidates every existing session and refresh token.
AUTH_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Leave COOKIE_DOMAIN unset for localhost. Set it (e.g. .lien.app) only when
# the frontend and API are on sibling subdomains of one parent domain.
# COOKIE_DOMAIN=
# Required in production once served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Comma separated. Must match the frontend origin exactly; no trailing slash.
CORS_ORIGINS=http://localhost:3000
# Enable behind a reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=false

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
LOG_PRETTY=true

# --- File uploads -----------------------------------------------------------
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=10485760
SERVE_UPLOADS_LOCALLY=true

# --- Email (optional) -------------------------------------------------------
# Configure an SMTP account to deliver verification and password-reset emails.
# Resend: add RESEND_API_KEY and use your verified domain in SMTP_FROM.
# Generic SMTP: SMTP_HOST and SMTP_PORT are required.
# In development without working SMTP, auth forms show local verification/reset
# links. These fallbacks are never returned in production, and tokens are not logged.
# RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Lien <no-reply@your-verified-domain.com>
SUPPORT_EMAIL=jogabiro181@gmail.com

# --- AI (optional, off by default) ------------------------------------------
# Lien is fully usable with AI_PROVIDER=none. The assistant only parses
# natural language into structured filters; it never scores, ranks, or chooses
# a match. Scoring is deterministic in code.
AI_PROVIDER=none
# AI_API_KEY=
# AI_BASE_URL=
AI_CHAT_MODEL=gpt-4o-mini
# Ordered failover chain (JSON array). Tried AFTER the primary provider above.
# If a target errors, is overloaded, or returns no usable content, the next one
# answers the request. Entries are tried in order; multiple models may be listed.
#   AI_FALLBACKS=[{"provider":"openrouter","label":"OpenRouter","baseUrl":"https://openrouter.ai/api/v1","apiKey":"sk-or-...","models":["vendor/model-a:free","vendor/model-b:free"]}]
# AI_FALLBACKS=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=900
AI_CACHE_TTL_MIN=30
# Must match the vector column width in migration 005.
EMBEDDING_DIMENSIONS=1536

# --- Live video (optional, off by default) ----------------------------------
# Study sessions work fully without LiveKit: text chat, shared notes, the
# question queue, roles, agenda and timer all run over the API and WebSocket.
# When the three LiveKit values below are set, the API mints short-lived room
# tokens and the session meeting panel becomes a real video room. Until then the
# meeting endpoint answers 503 MEETING_NOT_CONFIGURED and the UI shows a clear
# "meeting not configured" state instead of a fake room.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600

# --- Video meetings / Jitsi (optional, sensible defaults) --------------------
# TWIGANE embeds Jitsi Meet via the official IFrame API
# (https://<domain>/external_api.js). The default meet.jit.si domain welcomes
# integration TESTING but is NOT meant for production apps — for production,
# use Jitsi-as-a-Service or a self-hosted deployment and set JITSI_DOMAIN
# to that host (bare hostname, no scheme). GOOGLE_MEET meetings need none of
# this: the leader pastes their own meet.google.com link and members open it
# in a new tab. See docs/video-meetings.md.
JITSI_DOMAIN=meet.jit.si
# JITSI_APP_ID=            # JaaS AppID, only for a managed deployment
# JITSI_JWT_SECRET=        # self-hosted token auth only; server-side, never public
# JITSI_JWT_APP_ID=        # self-hosted token auth only
JITSI_ROOM_PREFIX=twigane
# JITSI | LIVEKIT | GOOGLE_MEET | NONE
VIDEO_PROVIDER_DEFAULT=JITSI

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=15
SEARCH_RATE_LIMIT_MAX=60
WRITE_RATE_LIMIT_MAX=120

# --- Demo data --------------------------------------------------------------
# Seeding reference data (universities, courses, topics, goals) is always safe.
# Demo accounts, groups, and activity are only created when this is true.
SEED_DEMO_DATA=false